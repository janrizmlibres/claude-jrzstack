#!/usr/bin/env bash
# run <script> [args...]
#
# Runs one of savvy-mode's scripts (orch, watch-pr, check-plan.mjs) with Bun
# when it is installed, and otherwise with Node 22.18+ or 24.2+, the releases
# that both strip TypeScript types by default and have import.meta.main. A
# relative <script> resolves beside this launcher, so
# `run orch/orch.ts init` works from any directory.
#
# Exits with the script's own code, or:
#   69  no usable runtime: prints the install line
#   64  no script given
set -u

missing_runtime_code=69
usage_code=64

if [ $# -eq 0 ]; then
  echo "usage: run <script> [args...]" >&2
  exit "$usage_code"
fi

script="$1"
shift
here="${BASH_SOURCE[0]%/*}"
[ "$here" = "${BASH_SOURCE[0]}" ] && here=.
case "$script" in
  /*) path="$script" ;;
  *) path="$(CDPATH='' cd -- "$here" >/dev/null && pwd)/$script" ;;
esac

if command -v bun >/dev/null 2>&1; then
  exec bun --no-install "$path" "$@"
fi

found_note=""
if command -v node >/dev/null 2>&1; then
  version="$(node --version 2>/dev/null)"
  if [[ "$version" =~ ^v([0-9]+)\.([0-9]+)\. ]]; then
    major="${BASH_REMATCH[1]}"
    minor="${BASH_REMATCH[2]}"
    if { [ "$major" -eq 22 ] && [ "$minor" -ge 18 ]; } ||
      { [ "$major" -eq 24 ] && [ "$minor" -ge 2 ]; } ||
      [ "$major" -ge 25 ]; then
      exec node "$path" "$@"
    fi
  fi
  found_note=" (found node ${version:-of unknown version}, which lacks one of them)"
fi

echo "run: $script needs Bun, or Node 22.18+ (24.2+ on Node 24) for type stripping and import.meta.main$found_note." >&2
echo "Install Bun: curl -fsSL https://bun.sh/install | bash" >&2
exit "$missing_runtime_code"
